# Copy to .env and replace every replace-* value. Keep values shell-safe:
# letters, numbers, dot, dash and underscore only unless documented otherwise.
COMPOSE_PROJECT_NAME=qianfu-paypro
PAYPRO_IMAGE_TAG=20260725-isolated
PAYPRO_HOST_PORT=8889

PAYPRO_DB_NAME=paypro
PAYPRO_DB_USER=paypro
PAYPRO_DB_PASSWORD=replace-with-random-alphanumeric-32
PAYPRO_MYSQL_ROOT_PASSWORD=replace-with-random-alphanumeric-32
PAYPRO_REDIS_PASSWORD=replace-with-random-alphanumeric-32

# Safe while both payment methods remain disabled. Before real acceptance,
# replace with the actual public HTTPS PayPro origin.
PAYPRO_SITE=http://127.0.0.1:8889
PAYPRO_OPENAPI_SECRET=replace-with-existing-qianfu-paypro-secret
PAYPRO_ADMIN_TOKEN=replace-with-random-alphanumeric-48
PAYPRO_NOTIFY_ALLOWED_HOSTS=
PAYPRO_CALLBACK_TIMEOUT_MS=5000
PAYPRO_QR_CODE_NUM=2
PAYPRO_ALLOW_BUNDLED_QR_CODES=false

# Never enable until the corresponding QR assets and ownership are confirmed.
PAYPRO_ALIPAY_ENABLED=false
PAYPRO_ALIPAY_ALLOW_NIGHT=false
PAYPRO_ALIPAY_USE_LOCAL_QR=true
PAYPRO_WECHAT_ENABLED=false
PAYPRO_WECHAT_ALLOW_NIGHT=false
PAYPRO_WECHAT_USE_LOCAL_QR=true

# OpenAPI order creation sends an administrator review email. These values are
# mandatory before either payment method may be enabled.
PAYPRO_MAIL_HOST=localhost
PAYPRO_MAIL_PORT=25
PAYPRO_MAIL_USERNAME=
PAYPRO_MAIL_PASSWORD=
PAYPRO_MAIL_AUTH=false
PAYPRO_MAIL_STARTTLS=false
PAYPRO_MAIL_STARTTLS_REQUIRED=false
PAYPRO_MAIL_SENDER=
PAYPRO_MAIL_RECEIVER=
