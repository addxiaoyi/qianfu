描述: {{ .Annotations.description }}

{{ if .Annotations.runbook_url }}
处理手册: {{ .Annotations.runbook_url }}
{{ end }}
{{ if .Annotations.action }}
建议操作: {{ .Annotations.action }}
{{ end }}
---
{{ end }}
{{ end }}
