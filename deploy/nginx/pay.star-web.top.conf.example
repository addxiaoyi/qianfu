# Retained legacy hostname: pay.star-web.top
# Personal filing mode keeps the hostname only to close old links explicitly.

server {
    listen 80;
    listen [::]:80;
    server_name pay.star-web.top;
    default_type text/plain;
    return 410 "PERSONAL_FILING_DISABLED\n";
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pay.star-web.top;

    ssl_certificate     /etc/letsencrypt/live/pay.star-web.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pay.star-web.top/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        default_type text/plain;
        return 410 "PERSONAL_FILING_DISABLED\n";
    }
}
