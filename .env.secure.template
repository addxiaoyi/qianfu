# ============================================================
# 千服平台 (QianFu Platform) - 安全配置模板
# ============================================================
# 安全警告:
# 1. 此文件用于参考，请勿将包含真实密钥的 .env 文件提交到仓库
# 2. 所有密钥必须满足最小长度要求
# 3. 生产环境必须使用随机生成的强密钥
# ============================================================

# ------------------------------------------------------------
# 必需的配置 (必须替换)
# ------------------------------------------------------------

# JWT 密钥 - 生产环境必须使用至少 64 字符的随机字符串
# 生成命令: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<YOUR_JWT_SECRET_MIN_64_CHARS>

# 管理员令牌 - 生产环境必须使用至少 32 字符的随机字符串
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=<YOUR_ADMIN_TOKEN_MIN_32_CHARS>

# ------------------------------------------------------------
# Supabase 配置 (生产必需)
# ------------------------------------------------------------

# 项目 URL
SUPABASE_URL=<YOUR_SUPABASE_URL>

# 发布密钥 (公开，客户端使用)
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# Service Role 密钥 (极其敏感，仅服务端使用，切勿暴露)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ------------------------------------------------------------
# 飞书配置 (如使用)
# ------------------------------------------------------------

FEISHU_SMTP_HOST=<YOUR_FEISHU_SMTP_HOST>
FEISHU_SMTP_PORT=<YOUR_FEISHU_SMTP_PORT>
FEISHU_SMTP_LOGIN=<YOUR_FEISHU_EMAIL>@<YOUR_FEISHU_DOMAIN>
FEISHU_SMTP_KEY=<YOUR_FEISHU_SMTP_KEY>
FEISHU_SMTP_FROM=<YOUR_FEISHU_EMAIL>@<YOUR_FEISHU_DOMAIN>

# ------------------------------------------------------------
# Brevo SMTP 配置 (如使用)
# ------------------------------------------------------------

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=<YOUR_BREVO_SMTP_LOGIN>
BREVO_SMTP_KEY=<YOUR_BREVO_SMTP_KEY>
BREVO_SMTP_FROM=<YOUR_BREVO_SMTP_FROM>
BREVO_SMTP_SECURE=false

BREVO_API_KEY=<YOUR_BREVO_API_KEY>
BREVO_API_BASE_URL=https://api.brevo.com/v3

# ------------------------------------------------------------
# 支付网关配置 (如使用)
# ------------------------------------------------------------

# XPay
XPAY_API_URL=<YOUR_XPAY_API_URL>
XPAY_TOKEN=<YOUR_XPAY_TOKEN>
XPAY_GATEWAY_BASE_URL=<YOUR_XPAY_GATEWAY_BASE_URL>
XPAY_GATEWAY_NOTIFY_SECRET=<YOUR_XPAY_GATEWAY_NOTIFY_SECRET>

# 支付宝
ALIPAY_APP_ID=<YOUR_ALIPAY_APP_ID>
ALIPAY_PRIVATE_KEY=<YOUR_ALIPAY_PRIVATE_KEY>
ALIPAY_PUBLIC_KEY=<YOUR_ALIPAY_PUBLIC_KEY>

# 微信支付
WECHAT_PAY_APP_ID=<YOUR_WECHAT_PAY_APP_ID>
WECHAT_PAY_MCH_ID=<YOUR_WECHAT_PAY_MCH_ID>
WECHAT_PAY_API_KEY=<YOUR_WECHAT_PAY_API_KEY>

# ------------------------------------------------------------
# 千服集成配置 (如使用)
# ------------------------------------------------------------

QIANFU_ENABLED=<true_or_false>
QIANFU_APP_ID=<YOUR_QIANFU_APP_ID>
QIANFU_SECRET_KEY=<YOUR_QIANFU_SECRET_KEY>
QIANFU_API_URL=<YOUR_QIANFU_API_URL>

# ------------------------------------------------------------
# 其他敏感配置
# ------------------------------------------------------------

# CMS API Key
CMS_API_KEY=<YOUR_CMS_API_KEY>

# Modertion 加密密钥 (用于加密存储敏感配置)
MODERATION_ENCRYPTION_KEY=<YOUR_MODERATION_ENCRYPTION_KEY_32_CHARS>

# 内容审核 API
CONTENT_MODERATION_API_KEY=<YOUR_CONTENT_MODERATION_API_KEY>
CONTENT_MODERATION_ENDPOINT=<YOUR_CONTENT_MODERATION_ENDPOINT>

# Sentry 错误追踪
SENTRY_DSN=<YOUR_SENTRY_DSN>

# ------------------------------------------------------------
# 开发环境专用 (切勿在生产环境使用)
# ------------------------------------------------------------

# 开发认证绕过 (仅 NODE_ENV=development 时生效)
DEV_AUTH_ENABLED=<true_or_false>
DEV_AUTH_USERNAME=<YOUR_DEV_USERNAME>
DEV_AUTH_PASSWORD=<YOUR_DEV_PASSWORD>
DEV_AUTH_SECRET=<YOUR_DEV_AUTH_SECRET>

# ------------------------------------------------------------
# 服务器配置
# ------------------------------------------------------------

PORT=3000
HOST=0.0.0.0
NODE_ENV=<development_or_production>

# 数据库
DATABASE_URL=<YOUR_DATABASE_URL>

# Redis
REDIS_URL=<YOUR_REDIS_URL>
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# CORS
CORS_ORIGIN=<YOUR_CORS_ORIGIN>
FRONTEND_URL=<YOUR_FRONTEND_URL>
