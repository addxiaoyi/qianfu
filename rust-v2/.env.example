# Required for docker compose. Generate unique values for every environment.
QF_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
QF_SESSION_SECRET=replace-with-a-long-random-session-secret
QF_METRICS_TOKEN=replace-with-a-random-metrics-token

# Production browser/API settings.
QF_COOKIE_SECURE=true
QF_ALLOWED_ORIGINS=https://app.example.com
QF_FRONTEND_URL=https://app.example.com

# GitHub OAuth. The callback URL must exactly match the GitHub OAuth App setting.
QF_GITHUB_CLIENT_ID=
QF_GITHUB_CLIENT_SECRET=
QF_GITHUB_REDIRECT_URI=https://api.example.com/api/v2/auth/github/callback

# Mail delivery.
QF_SMTP_HOST=
QF_SMTP_PORT=587
QF_SMTP_USERNAME=
QF_SMTP_PASSWORD=
QF_SMTP_FROM=

# Choose only the DNS provider used by enabled suffixes.
QF_CLOUDFLARE_API_TOKEN=
QF_CLOUDFLARE_ZONE_ID=
QF_ALIYUN_ACCESS_KEY_ID=
QF_ALIYUN_ACCESS_KEY_SECRET=
QF_ALIYUN_DNS_ZONE=
QF_ALIYUN_DNS_ENDPOINT=

# R2-compatible media storage.
QF_R2_ENDPOINT=
QF_R2_BUCKET=
QF_R2_PUBLIC_URL=
QF_R2_ACCESS_KEY_ID=
QF_R2_SECRET_ACCESS_KEY=
