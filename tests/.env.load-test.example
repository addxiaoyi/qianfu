# 负载测试环境变量配置
# 优化项 203: 性能测试 - 负载测试

# ============================================================
# 测试目标配置
# ============================================================

# 负载测试目标 URL
TEST_BASE_URL=http://localhost:3000

# 测试环境
TEST_ENV=development

# ============================================================
# Autocannon 配置
# ============================================================

# 默认并发连接数
AUTOCANNON_CONNECTIONS=10

# 默认测试时长(秒)
AUTOCANNON_DURATION=10

# HTTP pipelining 数量
AUTOCANNON_PIPELINING=1

# ============================================================
# K6 配置
# ============================================================

# K6 Cloud Token (可选)
# K6_CLOUD_TOKEN=

# 测试场景 (smoke, light, medium, stress, all)
TEST_SCENARIOS=smoke

# ============================================================
# 性能阈值
# ============================================================

# 最小 RPS
MIN_RPS=50

# 最大 P95 延迟 (ms)
MAX_P95_LATENCY=500

# 最大错误率 (%)
MAX_ERROR_RATE=5

# ============================================================
# CI 配置
# ============================================================

# 回归检测阈值 (%)
REGRESSION_RPS_THRESHOLD=10
REGRESSION_LATENCY_THRESHOLD=20

# 持续负载测试时长(秒)
SUSTAINED_LOAD_DURATION=60
