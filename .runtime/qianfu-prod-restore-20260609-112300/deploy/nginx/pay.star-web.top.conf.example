# Pay domain deployment: pay.star-web.top
# HTTPS terminates at Nginx, backend API stays on 127.0.0.1:3000

upstream qianfu_pay_api {
    server 127.0.0.1:3000;
    keepalive 64;
}

upstream qianfu_pay_xpay {
    server 127.0.0.1:8889;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name pay.star-web.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pay.star-web.top;

    ssl_certificate     /etc/letsencrypt/live/pay.star-web.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pay.star-web.top/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    client_max_body_size 10m;

    location = / {
        default_type text/plain;
        return 200 "qianfu-pay-gateway\n";
    }

    location /api/ {
        proxy_pass http://qianfu_pay_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

    location /auth/ {
        proxy_pass http://qianfu_pay_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

    location /xpay/ {
        rewrite ^/xpay/?(.*)$ /$1 break;
        proxy_pass http://qianfu_pay_xpay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

    location = /health {
        proxy_pass http://qianfu_pay_api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
