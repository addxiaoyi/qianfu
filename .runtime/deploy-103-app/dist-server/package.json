{
    "name": "qianfu",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "vite",
        "dev:open": "vite --open",
        "dev:poll": "cross-env VITE_USE_POLLING=1 vite",
        "dev:stack": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
        "dev:stack:open": "concurrently -n web,api -c cyan,magenta \"vite --open\" \"tsx watch server/index.ts\"",
        "xpay:dev": "node scripts/run-xpay-dev.mjs",
        "dev:stack:xpay": "concurrently -n web,api,xpay -c cyan,magenta,green \"vite\" \"tsx watch server/index.ts\" \"node scripts/run-xpay-dev.mjs\"",
        "dev:stack:xpay:open": "concurrently -n web,api,xpay -c cyan,magenta,green \"vite --open\" \"tsx watch server/index.ts\" \"node scripts/run-xpay-dev.mjs\"",
        "supertokens:up": "docker compose -f docker-compose.supertokens.yml up -d",
        "supertokens:down": "docker compose -f docker-compose.supertokens.yml down",
        "supertokens:logs": "docker compose -f docker-compose.supertokens.yml logs -f --tail=100",
        "local:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-product-local.ps1",
        "local:prepare": "prisma generate && prisma migrate deploy",
        "local:verify": "tsx scripts/verify-local-closed-loop.ts",
        "fullstack:up": "docker compose --env-file .env.fullstack -f docker-compose.fullstack.yml up -d --build",
        "fullstack:down": "docker compose --env-file .env.fullstack -f docker-compose.fullstack.yml down",
        "fullstack:logs": "docker compose --env-file .env.fullstack -f docker-compose.fullstack.yml logs -f --tail=200",
        "offline:up": "docker compose --env-file .env.offline -f docker-compose.offline.yml up -d",
        "offline:down": "docker compose --env-file .env.offline -f docker-compose.offline.yml down",
        "offline:logs": "docker compose --env-file .env.offline -f docker-compose.offline.yml logs -f --tail=200",
        "offline:bundle": "bash scripts/linux/package-offline-bundle.sh offline-bundle",
        "offline:installer": "bash scripts/linux/make-offline-installer.sh offline-bundle qianfu-offline-installer.tar.gz",
        "offline:installer:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/make-offline-installer.ps1",
        "fullstack:auto": "bash scripts/linux/start-fullstack-auto.sh",
        "fullstack:stop": "bash scripts/linux/stop-fullstack-auto.sh",
        "portable:bundle:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/make-portable-bundle.ps1",
        "deploy:paypro:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/deploy-paypro-oneclick.ps1",
        "portable:bundle:linux": "bash scripts/linux/make-portable-bundle-linux.sh portable-bundle-linux",
        "portable:verify:linux": "bash scripts/linux/verify-portable.sh",
        "offline:verify": "bash scripts/linux/verify-offline-stack.sh reports",
        "offline:diag": "bash scripts/linux/collect-diagnostics.sh diagnostics",
        "deploy:bt": "bash scripts/linux/deploy-bt-oneclick.sh",
        "build": "npm --prefix qianfu-liandeng run build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 500",
        "typecheck": "tsc --noEmit",
        "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
        "validate": "npm run typecheck && npm run typecheck:server && npm run lint && npm run guard:structure && npm run guard:api-contract && npm run guard:openapi-sync && npm run guard:style-tokens && npm run test:preload && npm run test:coverage:critical",
        "validate:env": "tsx scripts/validate-runtime-env.ts",
        "smoke:api": "tsx scripts/smoke-api.ts",
        "smoke:api:local": "tsx scripts/smoke-api-local.ts",
        "smoke:deploy": "tsx scripts/smoke-deploy.ts",
        "smoke:brevo": "tsx scripts/smoke-brevo.ts",
        "smoke:brevo:send": "tsx scripts/smoke-brevo-send.ts",
        "smoke:auth-mail": "tsx scripts/smoke-auth-mail.ts",
        "exp:test-api": "tsx scripts/experimental/test-api.ts",
        "exp:test-redis": "tsx scripts/experimental/test-redis-cache.ts",
        "exp:test-supabase": "tsx scripts/experimental/test-supabase-connection.ts",
        "release:preflight": "npm run smoke:api:local && npm run validate && npm run guard:style-tokens:strict && npm run build && npm run validate:env",
        "preview": "vite preview",
        "server": "tsx watch server/index.ts",
        "server:build": "tsc -p tsconfig.server.json && node scripts/fix-esm-import-extensions.mjs packages/shared/dist && node scripts/fix-esm-import-extensions.mjs dist-server && node scripts/sync-prisma-client-to-dist.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "npm run test:coverage:full",
        "test:coverage:full": "cross-env COVERAGE_SCOPE=full vitest run --coverage",
        "test:coverage:critical": "cross-env COVERAGE_SCOPE=critical vitest run --coverage tests/unit/useBufferedFetch.test.tsx tests/unit/usePaymentStatusPolling.test.tsx tests/unit/useToastProvider.test.tsx tests/unit/EditorPage.autosave.test.tsx tests/unit/compare-versions-validation.test.ts tests/unit/user.test.ts tests/unit/server.test.ts tests/unit/payment-guardrails.test.ts tests/unit/payment-cancel-policy.test.ts tests/unit/payment-timeout-policy.test.ts",
        "test:preload": "vitest run tests/unit/debug-flags.test.ts tests/unit/preload-candidates.test.ts tests/unit/preload-trace.test.ts tests/unit/preload-feature-gate.test.ts tests/unit/preload-route-chunks.test.ts",
        "clean:project": "tsx scripts/cleanup-project.ts",
        "clean:project:apply": "tsx scripts/cleanup-project.ts --apply",
        "guard:structure": "tsx scripts/structure-guard.ts",
        "guard:api-contract": "tsx scripts/api-contract-guard.ts",
        "guard:openapi-sync": "tsx scripts/openapi-sync-guard.ts",
        "guard:style-tokens": "tsx scripts/style-token-guard.ts",
        "guard:style-tokens:strict": "tsx scripts/style-token-guard.ts --strict",
        "postinstall": "prisma generate",
        "generate:openapi": "tsx scripts/generate-openapi.ts",
        "generate:openapi:types": "openapi-typescript docs/openapi.generated.json -o src/types/openapi.generated.d.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "^5.90.21",
        "@tiptap/extension-image": "^3.20.2",
        "@tiptap/extension-link": "^3.20.2",
        "@tiptap/extension-placeholder": "^3.20.2",
        "@tiptap/react": "^3.20.2",
        "@tiptap/starter-kit": "^3.20.2",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "date-fns": "^4.1.0",
        "dompurify": "^3.3.3",
        "dotenv": "^16.6.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "express-validator": "^7.3.1",
        "file-type": "^21.3.2",
        "framer-motion": "^12.36.0",
        "helmet": "^8.1.0",
        "highlight.js": "^11.11.1",
        "hpp": "^0.2.3",
        "http-proxy-middleware": "^3.0.5",
        "i18next": "^25.9.0",
        "ioredis": "^5.10.0",
        "json-stringify-safe": "^5.0.1",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.577.0",
        "markdown-it": "^14.1.1",
        "minecraft-server-util": "^5.4.4",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.2",
        "prom-client": "^15.1.3",
        "prometheus-api-metrics": "^4.0.0",
        "qrcode": "^1.5.4",
        "rate-limit-redis": "^4.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^16.5.8",
        "recharts": "^3.8.0",
        "sanitize-html": "^2.17.1",
        "sharp": "^0.34.5",
        "supertokens-auth-react": "^0.51.2",
        "supertokens-node": "^24.0.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "tailwind-merge": "^3.5.0",
        "tinymce": "^8.3.2",
        "uuid": "^13.0.0",
        "vditor": "^3.11.2",
        "winston": "^3.19.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.18",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.2",
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/hpp": "^0.2.7",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/markdown-it": "^14.1.2",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.14.0",
        "@types/nodemailer": "^8.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/sanitize-html": "^2.16.1",
        "@types/supertest": "^6.0.2",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^7.13.1",
        "@typescript-eslint/parser": "^7.13.1",
        "@vitejs/plugin-react": "^4.3.1",
        "@vitest/coverage-v8": "^4.1.3",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^17.6.0",
        "happy-dom": "^20.8.4",
        "jsdom": "^28.1.0",
        "openapi-typescript": "^7.10.1",
        "prisma": "^5.22.0",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.1.18",
        "tailwindcss-animate": "^1.0.7",
        "ts-node": "^10.9.2",
        "tsx": "^4.15.0",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.59.3",
        "vite": "^5.3.1",
        "vitest": "^4.1.0"
    }
}
