# ============================================
# Server 应用 - 环境变量配置示例
# 配置中心化 - server/config/env.ts
# ============================================

# ============================================
# 应用环境
# ============================================
NODE_ENV=development
# 可选值: development | production | test

# ============================================
# 服务器配置
# ============================================
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
API_PREFIX=/api
REQUEST_TIMEOUT=30000

# ============================================
# 日志配置
# ============================================
# 可选值: debug | info | warn | error
LOG_LEVEL=debug

# ============================================
# 上传配置
# ============================================
UPLOAD_STORAGE_DIR=./uploads
CDN_PREFIX=/cdn
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif,image/tiff,image/bmp
MAX_FILE_SIZE=10485760
DEFAULT_IMAGE_QUALITY=80
ENABLE_AVIF=false

# ============================================
# 图片格式优化配置 (WebP转换)
# ============================================
# 默认输出格式: webp | jpeg | avif
DEFAULT_IMAGE_FORMAT=webp
# WebP压缩级别 (1-6, 默认4)
# 1=最快/最大, 6=最慢/最小, 4=平衡
WEBP_EFFORT=4

# ============================================
# 安全配置
# ============================================
# 允许的跨域来源 (多个用逗号分隔)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 数据加密密钥 (生产环境必须设置)
DATA_ENCRYPTION_KEY=
FORCE_HTTPS=false

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5000

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/app
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_QUERY_TIMEOUT=30000

# ============================================
# CDN 配置
# ============================================
CDN_DOMAIN=
CDN_SECRET=
CDN_SIGNED_URL_EXPIRY=3600

# ============================================
# 缓存配置
# ============================================
CACHE_L1_TTL=30000
CACHE_L2_TTL=300000
CACHE_MAX_ENTRIES=1000

# ============================================
# AI 服务配置
# ============================================
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Cohere
COHERE_API_KEY=

# Hugging Face
HUGGINGFACE_API_KEY=

# Weaviate 向量数据库
WEAVIATE_URL=
WEAVIATE_API_KEY=

# ============================================
# RAG 知识增强配置
# ============================================
# RAG 服务开关
RAG_ENABLED=true
# 默认知识库集合名称
RAG_DEFAULT_COLLECTION=default

# LLM 配置
LLM_PROVIDER=openai
# 可选: openai | anthropic | local
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
# LLM API Base URL (用于代理或自定义端点)
LLM_BASE_URL=

# 向量检索配置
VECTOR_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.7
VECTOR_HYBRID_ALPHA=0.5
# 启用重排序 (需要额外的 reranker 服务)
VECTOR_ENABLE_RERANK=false
# 启用 MMR 多样性优化
VECTOR_ENABLE_MMR=false

# 分块配置 (基于 Token)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_LENGTH=50
CHUNK_MAX_LENGTH=2000

# RAG 缓存配置
RAG_CACHE_ENABLED=true
RAG_CACHE_L1_TTL=30000
RAG_CACHE_L2_TTL=300000

# ============================================
# 智能客服配置 (优化项 398)
# ============================================
# 智能客服开关
CUSTOMER_SERVICE_ENABLED=true
# 客服知识库集合名称
CUSTOMER_SERVICE_COLLECTION=customer_service
# 转人工关键词 (逗号分隔)
CUSTOMER_SERVICE_ESCALATION_KEYWORDS=人工,转人工,客服,投诉,升级,经理
# 客服使用的 LLM 模型
CUSTOMER_SERVICE_LLM_MODEL=gpt-4o-mini
# 客服回复温度系数 (0-1, 默认 0.7)
CUSTOMER_SERVICE_TEMPERATURE=0.7
# 最大历史消息数
CUSTOMER_SERVICE_MAX_HISTORY=20
# 会话超时时间 (毫秒, 默认 30 分钟)
CUSTOMER_SERVICE_SESSION_TIMEOUT=1800000

# ============================================
# 故障注入配置 (优化项 496: Fault Injection)
# ============================================
# 故障注入开关 (默认 false，生产环境强烈建议关闭)
FAULT_INJECTION_ENABLED=false
# 是否记录故障注入日志
FAULT_INJECTION_LOG_ENABLED=true
# 是否在响应头标记故障注入
FAULT_INJECTION_MARK_RESPONSE=true
# 默认故障触发概率 (0-1)
FAULT_INJECTION_DEFAULT_PROBABILITY=1.0
# 默认延迟时间 (毫秒)
FAULT_INJECTION_DEFAULT_DELAY=1000
# 默认错误状态码
FAULT_INJECTION_DEFAULT_ERROR_CODE=500
# 预定义场景: none | highLatency | randomErrors | serviceDown | timeouts | chaosEngineering
FAULT_INJECTION_SCENARIO=none

# ============================================
# RFM 用户价值分析配置 (优化项 311)
# ============================================
# 分析时段 (天, 默认 90)
RFM_ANALYSIS_PERIOD_DAYS=90
# R 评分阈值: 最近性分段天数 (逗号分隔)
RFM_RECENCY_THRESHOLDS=7,30,60,90
# F 评分阈值: 频率分段次数 (逗号分隔)
RFM_FREQUENCY_THRESHOLDS=1,3,5,10
# M 评分阈值: 金额分段金额 (逗号分隔)
RFM_MONETARY_THRESHOLDS=100,500,1000,5000
# 是否启用缓存 (默认 true)
RFM_CACHE_ENABLED=true
# 缓存 TTL (毫秒, 默认 3600000 = 1小时)
RFM_CACHE_TTL=3600000

# ============================================
# SSE 实时推送配置 (优化项 24: Server-Sent Events)
# ============================================
# SSE 功能开关 (默认 true)
SSE_ENABLED=true
# 心跳间隔 (毫秒, 默认 30000)
SSE_HEARTBEAT_INTERVAL=30000
# 最大并发连接数 (默认 1000)
SSE_MAX_CONNECTIONS=1000
# 连接超时时间 (毫秒, 默认 3600000 = 1小时)
SSE_CONNECTION_TIMEOUT=3600000

# ============================================
# SQL 日志记录配置 (优化项 46: SQL 慢查询分析)
# ============================================
# SQL 日志开关 (默认 true)
SQL_LOG_ENABLED=true
# 慢查询阈值 (毫秒, 默认 1000)
SQL_SLOW_QUERY_THRESHOLD=1000
# 记录所有查询 (默认 false, 生产环境建议 false)
SQL_LOG_ALL=false
# 最大查询日志长度 (默认 1000)
SQL_MAX_QUERY_LENGTH=1000
# 是否记录查询参数 (默认 false, 生产环境建议 false)
SQL_LOG_PARAMS=false
# 是否包含 EXPLAIN ANALYZE (默认 false)
SQL_INCLUDE_EXPLAIN=false

# ============================================
# 管理员 API 配置
# ============================================
# 管理员 API 密钥 (用于访问管理接口)
ADMIN_API_KEY=your-secure-admin-key-here
