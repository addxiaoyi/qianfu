{
  "name": "qianfu-liandeng",
  "version": "1.0.0",
  "private": true,
  "description": "千服链等 - Minecraft服务器租用平台",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:prettier": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot:update": "vitest run --config vitest.snapshot.config.ts --update",
    "test:snapshot:watch": "vitest --config vitest.snapshot.config.ts --watch",
    "test:integration": "vitest run --config vitest.config.ts --testPathPattern integration",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config=playwright.api.config.ts",
    "test:e2e:compliance": "playwright test tests/e2e/compliance-api.spec.ts --config=playwright.api.config.ts",
    "test:e2e:semantic": "playwright test tests/e2e/semantic-search-api.spec.ts --config=playwright.api.config.ts",
    "test:e2e:metrics": "playwright test tests/e2e/metrics-api.spec.ts --config=playwright.api.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:load:watch": "vitest --config vitest.load.config.ts --watch",
    "test:load:autocannon": "node scripts/load-test/autocannon-runner.mjs",
    "test:load:k6": "k6 run scripts/load-test/k6-scenarios.js",
    "test:load:ci": "node scripts/load-test/ci-runner.mjs",
    "test:load:report": "node scripts/load-test/generate-report.mjs",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:report": "vitest run --coverage && concurrently \"vitest preview\" \"open coverage/index.html\"",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run --concurrency 4",
    "test:mutation:watch": "stryker run --watch",
    "test:mutation:report": "stryker run && open coverage/mutation/mutation-report.html",
    "test:mutation:analyze": "node scripts/mutation-analysis.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "autocannon": "^7.14.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.0.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
