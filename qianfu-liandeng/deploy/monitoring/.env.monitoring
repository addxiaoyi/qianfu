# ============================================
# 监控告警系统 - 环境变量配置
# ============================================

# ============================================
# Prometheus 配置
# ============================================
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_STORAGE_TSDB_PATH=/prometheus

# ============================================
# Grafana 配置
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_DOMAIN=localhost:3000
GRAFANA_FROM_EMAIL=noreply@example.com

# ============================================
# SMTP 配置 (邮件告警)
# ============================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================
# 告警通知配置
# ============================================
# Slack Webhook URL
SLACK_WEBHOOK_URL=

# 钉钉 Webhook URL
DINGTALK_WEBHOOK_URL=

# 企业微信 Webhook URL
WECHAT_WEBHOOK_URL=

# ============================================
# 外部服务认证
# ============================================
# Prometheus API Token (用于 Grafana 等外部访问)
PROMETHEUS_API_TOKEN=

# ============================================
# 告警通知规则
# ============================================
# 告警重发间隔
ALERT_REPEAT_INTERVAL=4h

# 告警分组等待时间
ALERT_GROUP_WAIT=30s

# ============================================
# 告警级别阈值
# ============================================
# CPU 告警阈值
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=95

# 内存告警阈值
MEMORY_WARNING_THRESHOLD=85
MEMORY_CRITICAL_THRESHOLD=95

# 磁盘告警阈值
DISK_WARNING_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=95

# HTTP 错误率告警阈值
HTTP_5XX_WARNING_RATE=0.05
HTTP_5XX_CRITICAL_RATE=0.20

# 延迟告警阈值 (秒)
LATENCY_P95_WARNING=1
LATENCY_P95_CRITICAL=5

# ============================================
# 应用错误日志告警阈值
# ============================================
# 应用错误日志率告警阈值 (每秒错误数)
APP_ERROR_WARNING_RATE=0.1
APP_ERROR_CRITICAL_RATE=0.5

# 认证错误率告警阈值
AUTH_ERROR_RATE=0.05

# 安全错误率告警阈值
SECURITY_ERROR_RATE=0.02

# 支付错误率告警阈值
PAYMENT_ERROR_RATE=0.01

# API 错误率告警阈值
API_ERROR_RATE=0.1

# 错误日志突增阈值 (1分钟内增加数)
APP_ERROR_BURST_THRESHOLD=10
