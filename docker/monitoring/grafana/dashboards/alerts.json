groups:
  - name: qianfu.alerts
    interval: 30s
    rules:
      # High API Latency
      - alert: HighAPILatency
        expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) > 2
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "API P95 延迟过高"
          description: "API P95 延迟已超过 2 秒，当前值: {{ $value }}s"

      # Critical API Latency
      - alert: CriticalAPILatency
        expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) > 5
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "API P95 延迟严重过高"
          description: "API P95 延迟已超过 5 秒，当前值: {{ $value }}s"

      # High Error Rate
      - alert: HighErrorRate
        expr: sum(rate(http_requests_total{status_code=~"5.."}[5m])) / sum(rate(http_requests_total[5m])) > 0.05
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "API 错误率过高"
          description: "5xx 错误率超过 5%，当前值: {{ $value | humanizePercentage }}"

      # Circuit Breaker Open
      - alert: CircuitBreakerOpen
        expr: qianfu_circuit_breaker_state == 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "服务熔断器打开"
          description: "服务 {{ $labels.service }} 的熔断器已打开"

      # Low Cache Hit Ratio
      - alert: LowCacheHitRatio
        expr: redis_cache_hit_ratio < 0.5
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "缓存命中率过低"
          description: "Redis 缓存命中率低于 50%，当前值: {{ $value | humanizePercentage }}"

      # High Auth Failure Rate
      - alert: HighAuthFailureRate
        expr: sum(rate(qianfu_auth_attempts_total{status="failure"}[5m])) / sum(rate(qianfu_auth_attempts_total[5m])) > 0.3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "认证失败率过高"
          description: "认证失败率超过 30%，可能存在暴力破解"

      # Service Down
      - alert: ServiceDown
        expr: up{job=~"qianfu-.*"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "服务宕机"
          description: "服务 {{ $labels.job }} 已宕机超过 1 分钟"

      # Database Connection Pool Exhausted
      - alert: DatabasePoolExhausted
        expr: qianfu_db_connection_pool_size{state="active"} / qianfu_db_connection_pool_size{state="total"} > 0.9
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "数据库连接池即将耗尽"
          description: "数据库连接池使用率超过 90%"

      # High Payment Volume Anomaly
      - alert: PaymentAnomaly
        expr: abs(increase(qianfu_payment_total[1h])) > 1000000
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "支付金额异常"
          description: "过去 1 小时支付金额异常: {{ $value }}"
