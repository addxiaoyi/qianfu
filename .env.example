# ============================================================
# 千服平台 (QianFu Platform) - 安全环境变量模板
# ============================================================
# 安全警告: 此文件包含示例占位符，切勿在生产环境中使用！
# 复制此文件为 .env 并使用安全的随机值替换所有密钥
# cp .env.example .env
#
# ============================================================
# 密钥生成说明 (如何生成安全的随机密钥)
# ============================================================
# 1. 运行以下命令生成 64 字符 (256位) 的安全随机密钥:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 2. 密钥类型:
#    - JWT_SECRET: 用于签名 JWT 令牌的核心密钥
#    - ADMIN_TOKEN: 管理员 API 访问令牌
#    - PAYPRO_OPENAPI_SECRET: PayPro 支付回调签名验证
#    - WALLET_SECRET: 钱包余额操作安全签名
#    - XPAY_GATEWAY_NOTIFY_SECRET: XPay 网关回调签名
#    - XPAY_BRIDGE_NOTIFY_SECRET: XPay 桥接回调签名
#    - PERSONAL_QR_LISTENER_SECRET: 个人二维码监听器签名
#    - XPAY_TOKEN: XPay API 访问令牌
#    - MODERATION_ENCRYPTION_KEY: 审核与敏感平台配置加密密钥
#    - MAIL_CONFIG_ENCRYPTION_KEY: 邮件配置加密密钥
#    - MAIL_CONFIG_LEGACY_ENCRYPTION_KEY: 邮件配置旧版加密密钥
#
# 3. 安全要求:
#    - 所有密钥最小长度: 64 字符 (256 位)
#    - 生产环境必须使用强随机密钥，绝不使用示例值
#    - 切勿在代码仓库中提交实际密钥值！
#    - 建议使用密钥管理服务 (如 AWS Secrets Manager, HashiCorp Vault)
# ============================================================

# ------------------------------------------------------------
# 服务器配置
# ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# 环境 (development / staging / production)
NODE_ENV=development

# 个人备案模式：关闭支付、钱包扣款、推广和商城相关能力。
# 生产发布脚本会强制写入 true，避免沿用旧环境中的支付配置。
PERSONAL_FILING_MODE=true

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# SQLite (开发环境)
# Development default only. Production validation rejects file-based databases.
DATABASE_URL=file:./dev.db

# PostgreSQL (生产环境)
# DATABASE_URL=postgresql://user:password@localhost:5432/qianfu

# ============================================
# Prisma 连接池配置
# ============================================
# 连接池大小 (默认: SQLite=5, PostgreSQL/MySQL=20)
# PRISMA_CONNECTION_LIMIT=20

# 连接池获取超时 (秒, 默认: 10)
# PRISMA_POOL_TIMEOUT=10

# 慢查询阈值 (毫秒, 默认: 500)
# PRISMA_SLOW_QUERY_THRESHOLD=500

# Prisma 调试模式 (开发环境可选)
PRISMA_GENERATE_DATAPROXY=false

# ------------------------------------------------------------
# 认证配置 [高危 - 必须替换]
# ------------------------------------------------------------
# JWT_SECRET: 用于签名 JWT 令牌的核心密钥
#   - 最小长度: 64 字符 (256 位)
#   - 必须使用: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   - 生产环境必须使用强随机密钥！
# 示例安全值 (请替换为您自己生成的密钥):
JWT_SECRET=<YOUR_JWT_SECRET_HERE>

JWT_EXPIRES_IN=7d
LOCAL_AUTH_COOKIE_NAME=qf_auth_token

# Admin Token: 管理员 API 访问令牌
#   - 最小长度: 64 字符
#   - 必须使用: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   - 切勿在代码仓库中提交实际值！
# 示例安全值 (请替换为您自己生成的密钥):
ADMIN_TOKEN=<YOUR_ADMIN_TOKEN_HERE>

# ------------------------------------------------------------
# SuperTokens 配置
# ------------------------------------------------------------
SUPER_TOKENS_CONNECTION_URI=http://localhost:3567
SUPER_TOKENS_API_KEY=
API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# GitHub OAuth 配置
# ------------------------------------------------------------
# Client ID 可公开；Client Secret 只能配置在部署环境或密钥管理服务中。
# 切勿把真实 Client Secret 提交到仓库、日志、截图或聊天记录。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://example.com/api/v1/auth/github/callback
OAUTH_HTTP_TIMEOUT_MS=15000
OAUTH_HTTP_RETRIES=2
# 可选：平台绑定公开验证码的独立 HMAC 密钥；为空时回退到 JWT_SECRET。
PROMO_BINDING_VERIFICATION_SECRET=

# ------------------------------------------------------------
# CORS 配置
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
FORCE_HTTPS=false
TRUST_PROXY=false

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
# 生产环境必须显式启用；开发环境可保持 false 使用进程内回退。
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Redis 不可用时的进程内回退上限，避免故障期间无限增长。
REDIS_MEMORY_MAX_ENTRIES=1000
REDIS_MEMORY_CLEANUP_MS=60000

# ------------------------------------------------------------
# 文件存储
# ------------------------------------------------------------
# 生产环境使用绝对、独立、持久化路径，例如 /var/lib/qianfu/uploads
UPLOAD_DIR=./uploads
# Generic WAF body inspection is disabled for schema-validated /api routes by default.
WAF_INSPECT_API_BODY=false
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 图床转发（图片先经过本站安全校验和压缩；图床失败时自动使用本站存储）
IMAGE_HOST_ENABLED=false
IMAGE_HOST_UPLOAD_URL=
IMAGE_HOST_TOKEN=
IMAGE_HOST_AUTH_HEADER=Authorization
IMAGE_HOST_FILE_FIELD=file
IMAGE_HOST_RESPONSE_PATH=url

# Cloudflare R2 image storage. Keep credentials server-side only.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=qianfu-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://images.example.com

# ------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m

# ------------------------------------------------------------
# 内容审核
# ------------------------------------------------------------
# 审核与敏感平台配置加密密钥；生产环境必须使用独立强随机值。
MODERATION_ENCRYPTION_KEY=<YOUR_MODERATION_ENCRYPTION_KEY_HERE>
CONTENT_MODERATION_API_KEY=
CONTENT_MODERATION_ENDPOINT=

# ------------------------------------------------------------
# 监控和错误追踪
# ------------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true

# ============================================================
# 支付网关配置 [高危 - 必须替换所有密钥]
# ============================================================

# ------------------------------------------------------------
# XPay 配置
# ------------------------------------------------------------
API_PUBLIC_URL=http://localhost:3000
PAY_DOMAIN_HOST=
DEFAULT_PAYMENT_PROJECT_KEY=qianfu
DEFAULT_PAYMENT_UPSTREAM_PROVIDER=
DEFAULT_PAYMENT_BACKUP_PROVIDER=
XPAY_API_URL=http://127.0.0.1:8889/starmc/pay
# XPay API 令牌 - 示例安全值 (请替换):
XPAY_TOKEN=<YOUR_XPAY_TOKEN_HERE>
XPAY_NOTIFY_URL=http://localhost:3000/api/v1/payment/xpay/notify
XPAY_GATEWAY_BASE_URL=http://127.0.0.1:8888
# 网关回调签名密钥 - 示例安全值 (请替换):
XPAY_GATEWAY_NOTIFY_SECRET=<YOUR_XPAY_GATEWAY_NOTIFY_SECRET_HERE>
XPAY_TENANT_KEY=qianfu
# 桥接回调签名密钥 - 示例安全值 (请替换):
XPAY_BRIDGE_NOTIFY_SECRET=<YOUR_XPAY_BRIDGE_NOTIFY_SECRET_HERE>
# 个人二维码监听器签名密钥 - 示例安全值 (请替换):
PERSONAL_QR_LISTENER_SECRET=<YOUR_PERSONAL_QR_LISTENER_SECRET_HERE>
XPAY_PUBLIC_URL=http://127.0.0.1:8888

# XPay 支付宝配置
XPAY_PROVIDER_ALIPAY_ENABLED=false
XPAY_PROVIDER_ALIPAY_APP_ID=
XPAY_PROVIDER_ALIPAY_PRIVATE_KEY=
XPAY_PROVIDER_ALIPAY_PUBLIC_KEY=
XPAY_PROVIDER_ALIPAY_VERIFY_ENABLED=false
XPAY_PROVIDER_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
XPAY_PROVIDER_ALIPAY_CHARSET=UTF-8
XPAY_PROVIDER_ALIPAY_SIGN_TYPE=RSA2

# XPay 微信支付配置
XPAY_PROVIDER_WECHAT_ENABLED=false
XPAY_PROVIDER_WECHAT_VERIFY_ENABLED=false
XPAY_PROVIDER_WECHAT_API_KEY=
XPAY_PROVIDER_WECHAT_MCH_ID=
XPAY_PROVIDER_WECHAT_APP_ID=
XPAY_PROVIDER_WECHAT_UNIFIED_ORDER_URL=https://api.mch.weixin.qq.com/pay/unifiedorder
XPAY_PROVIDER_WECHAT_SPBILL_CREATE_IP=127.0.0.1

# ------------------------------------------------------------
# Creem 配置
# ------------------------------------------------------------
CREEM_API_BASE_URL=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
# JSON map: "custom:<wallet_cny_fen>:CNY" -> USD product + CNY wallet credit.
CREEM_PRODUCT_MAP_JSON=
CREEM_RETURN_URL=

# ------------------------------------------------------------
# PayPal Standard Checkout 配置
# ------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_API_BASE_URL=https://api-m.paypal.com
PAYPAL_RETURN_URL=https://mc-u.top/api/v1/payment/paypal/return
PAYPAL_CANCEL_URL=
PAYPAL_EXCHANGE_RATE_CNY_PER_USD=7
PAYMENT_DAILY_LIMIT_PAYPAL_CNY=0

# ------------------------------------------------------------
# 旧支付配置 (已弃用)
# ------------------------------------------------------------
QIUPAY_BASE_URL=
QIUPAY_PID=
QIUPAY_KEY=
QIUPAY_NOTIFY_URL=
QIUPAY_RETURN_URL=

# ------------------------------------------------------------
# TPay 配置
# ------------------------------------------------------------
TPAY_GATEWAY_URL=https://gateway.xddpay.com
TPAY_APP_ID=
TPAY_APP_SECRET=
TPAY_QUERY_URL=https://gateway.xddpay.com/query.ashx
TPAY_NOTIFY_IP_ALLOWLIST=

# ------------------------------------------------------------
# 虎皮椒配置
# ------------------------------------------------------------
HUPIJIAO_GATEWAY_URL=https://api.xunhupay.com/payment/do.html
HUPIJIAO_BACKUP_GATEWAY_URL=https://api.dpweixin.com/payment/do.html
HUPIJIAO_APP_ID=
HUPIJIAO_APP_SECRET=
HUPIJIAO_NOTIFY_URL=http://localhost:3000/api/v1/payment/hupijiao/notify
HUPIJIAO_RETURN_URL=
HUPIJIAO_PLUGINS=alipay
HUPIJIAO_VERSION=1.1
HUPIJIAO_NOTIFY_IP_ALLOWLIST=

# ------------------------------------------------------------
# PayPro 配置 [高危]
# ------------------------------------------------------------
# OPENAPI 密钥: 用于支付回调签名验证
#   - 最小长度: 64 字符
#   - 生成: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 示例安全值 (请替换为您自己生成的密钥):
PAYPRO_OPENAPI_SECRET=<YOUR_PAYPRO_OPENAPI_SECRET_HERE>
PAYPRO_TIMEOUT_MS=10000
PAYPRO_ENABLED=false
PAYPRO_API_URL=http://127.0.0.1:8889
PAYPRO_NOTIFY_URL=http://localhost:3000/api/v1/payment/paypro/notify
PAYPRO_DEV_MOCK_ENABLED=false
PAYPRO_DEV_MOCK_MARK_COMPLETED=false
# PAYPRO_DEV_MOCK_WECHAT_QR_URL=
# PAYPRO_DEV_MOCK_ALIPAY_QR_URL=

# ------------------------------------------------------------
# 钱包密钥 [高危]
# ------------------------------------------------------------
# 用于钱包余额操作的安全签名
# 示例安全值 (请替换为您自己生成的密钥):
WALLET_SECRET=<YOUR_WALLET_SECRET_HERE>

# ------------------------------------------------------------
# 重定向白名单
# ------------------------------------------------------------
VITE_ALLOWED_PAYMENT_REDIRECT_HOSTS=
TRUSTED_REDIRECT_HOSTS=

# ============================================================
# 邮件服务配置
# ============================================================
# 邮件加密密钥 [高危 - 如果使用邮件功能必须替换]
# 示例安全值 (请替换为您自己生成的密钥):
MAIL_CONFIG_ENCRYPTION_KEY=<YOUR_MAIL_CONFIG_ENCRYPTION_KEY_HERE>
# 旧版邮件加密密钥 [高危 - 如果有旧数据需要迁移必须替换]
# 示例安全值 (请替换为您自己生成的密钥):
MAIL_CONFIG_LEGACY_ENCRYPTION_KEY=<YOUR_MAIL_CONFIG_LEGACY_ENCRYPTION_KEY_HERE>

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_BASE_URL=http://localhost:3000
CONTACT_EMAIL=support@example.com
CONTACT_PHONE=

# ------------------------------------------------------------
# QA 自动化账号（可选）
# ------------------------------------------------------------
QA_LOGIN_IDENTIFIER=
QA_LOGIN_PASSWORD=
QA_ADMIN_IDENTIFIER=
QA_ADMIN_PASSWORD=

# ============================================================
# 安全检查清单
# ============================================================
# 在生产部署前，确保以下所有密钥都已替换:
#
# [ ] JWT_SECRET - 已生成安全值 (256位)
# [ ] ADMIN_TOKEN - 已生成安全值 (256位)
# [ ] PAYPRO_OPENAPI_SECRET - 已生成安全值 (256位)
# [ ] WALLET_SECRET - 已生成安全值 (256位)
# [ ] XPAY_GATEWAY_NOTIFY_SECRET - 已生成安全值 (256位)
# [ ] XPAY_BRIDGE_NOTIFY_SECRET - 已生成安全值 (256位)
# [ ] PERSONAL_QR_LISTENER_SECRET - 已生成安全值 (256位)
# [ ] XPAY_TOKEN - 已生成安全值 (256位)
# [ ] MODERATION_ENCRYPTION_KEY - 已生成安全值 (256位)
# [ ] MAIL_CONFIG_ENCRYPTION_KEY - 已生成安全值 (256位)
# [ ] MAIL_CONFIG_LEGACY_ENCRYPTION_KEY - 已生成安全值 (256位)
#
# 重要提醒:
# - 以上示例密钥仅用于开发/测试环境
# - 生产环境请使用命令重新生成:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# - 切勿将实际密钥提交到版本控制系统！
# - 建议使用环境变量注入或密钥管理服务
# OpenAI-compatible AI provider (server-side only)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-2.5-flash
AI_MODERATION_ENABLED=false
AI_MODERATION_MODEL=gemini-2.5-flash
VITE_API_V2=false
