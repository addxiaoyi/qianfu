# ============================================================
# 千服平台 (QianFu Platform) - 环境变量模板
# ============================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 服务器配置
# ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# 环境
NODE_ENV=development

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# SQLite (开发环境)
DATABASE_URL=file:./dev.db

# PostgreSQL (生产环境)
# DATABASE_URL=postgresql://user:password@localhost:5432/qianfu

# Prisma 调试模式 (开发环境可选)
PRISMA_GENERATE_DATAPROXY=false

# ------------------------------------------------------------
# 认证配置
# ------------------------------------------------------------
# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
LOCAL_AUTH_COOKIE_NAME=qf_auth_token

# SuperTokens 配置
SUPER_TOKENS_CONNECTION_URI=http://localhost:3567
SUPER_TOKENS_API_KEY=
API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# CORS 配置
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# 支付配置 (支付宝)
# ------------------------------------------------------------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付配置 (微信支付)
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_KEY_PATH=

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# 文件存储
# ------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m

# ------------------------------------------------------------
# 内容审核
# ------------------------------------------------------------
CONTENT_MODERATION_API_KEY=
CONTENT_MODERATION_ENDPOINT=

# ------------------------------------------------------------
# 监控和错误追踪
# ------------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true

# ------------------------------------------------------------
# 支付网关 / XPay
# ------------------------------------------------------------
API_PUBLIC_URL=http://localhost:3000
PAY_DOMAIN_HOST=
DEFAULT_PAYMENT_PROJECT_KEY=qianfu
DEFAULT_PAYMENT_UPSTREAM_PROVIDER=xpay
DEFAULT_PAYMENT_BACKUP_PROVIDER=
XPAY_API_URL=http://127.0.0.1:8889/starmc/pay
XPAY_TOKEN=
XPAY_NOTIFY_URL=http://localhost:3000/api/v1/payment/xpay/notify
XPAY_GATEWAY_BASE_URL=http://127.0.0.1:8888
XPAY_GATEWAY_NOTIFY_SECRET=
XPAY_TENANT_KEY=qianfu
XPAY_BRIDGE_NOTIFY_SECRET=
PERSONAL_QR_LISTENER_SECRET=
XPAY_PUBLIC_URL=http://127.0.0.1:8888
XPAY_PROVIDER_ALIPAY_ENABLED=false
XPAY_PROVIDER_ALIPAY_APP_ID=
XPAY_PROVIDER_ALIPAY_PRIVATE_KEY=
XPAY_PROVIDER_ALIPAY_PUBLIC_KEY=
XPAY_PROVIDER_ALIPAY_VERIFY_ENABLED=false
XPAY_PROVIDER_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
XPAY_PROVIDER_ALIPAY_CHARSET=UTF-8
XPAY_PROVIDER_ALIPAY_SIGN_TYPE=RSA2
XPAY_PROVIDER_WECHAT_ENABLED=false
XPAY_PROVIDER_WECHAT_VERIFY_ENABLED=false
XPAY_PROVIDER_WECHAT_API_KEY=
XPAY_PROVIDER_WECHAT_MCH_ID=
XPAY_PROVIDER_WECHAT_APP_ID=
XPAY_PROVIDER_WECHAT_UNIFIED_ORDER_URL=https://api.mch.weixin.qq.com/pay/unifiedorder
XPAY_PROVIDER_WECHAT_SPBILL_CREATE_IP=127.0.0.1
CREEM_API_BASE_URL=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_RETURN_URL=
QIUPAY_BASE_URL=
QIUPAY_PID=
QIUPAY_KEY=
QIUPAY_NOTIFY_URL=
QIUPAY_RETURN_URL=
TPAY_GATEWAY_URL=https://gateway.xddpay.com
TPAY_APP_ID=
TPAY_APP_SECRET=
TPAY_QUERY_URL=https://gateway.xddpay.com/query.ashx
TPAY_NOTIFY_IP_ALLOWLIST=
HUPIJIAO_GATEWAY_URL=https://api.xunhupay.com/payment/do.html
HUPIJIAO_BACKUP_GATEWAY_URL=https://api.dpweixin.com/payment/do.html
HUPIJIAO_APP_ID=
HUPIJIAO_APP_SECRET=
HUPIJIAO_NOTIFY_URL=http://localhost:3000/api/v1/payment/hupijiao/notify
HUPIJIAO_RETURN_URL=
HUPIJIAO_PLUGINS=alipay
HUPIJIAO_VERSION=1.1
HUPIJIAO_NOTIFY_IP_ALLOWLIST=
WALLET_SECRET=
VITE_ALLOWED_PAYMENT_REDIRECT_HOSTS=mc-u.top,creem.io
TRUSTED_REDIRECT_HOSTS=mc-u.top,www.mc-u.top

# ------------------------------------------------------------
# 邮件服务 (可选)
# ------------------------------------------------------------
MAIL_CONFIG_ENCRYPTION_KEY=
MAIL_CONFIG_LEGACY_ENCRYPTION_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_BASE_URL=http://localhost:3000
CONTACT_EMAIL=support@example.com
CONTACT_PHONE=

# ------------------------------------------------------------
# QA 自动化账号（可选）
# ------------------------------------------------------------
QA_LOGIN_IDENTIFIER=
QA_LOGIN_PASSWORD=
QA_ADMIN_IDENTIFIER=
QA_ADMIN_PASSWORD=
