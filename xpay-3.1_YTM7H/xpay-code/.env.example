# ============================================
# StarMC Payment System - 千服集成配置
# ============================================
# 千服系统集成配置文件
# 复制此文件为 .env 并填写实际参数

# ========== 千服集成配置 ==========
QIANYU_ENABLED=true
QIANYU_APP_ID=xpay-starmc-2024
QIANYU_SECRET_KEY=a8f5f167f58447e16c4a8f5f167f5847
QIANYU_API_URL=http://121.196.161.249:8888/qianfu-api
QIANYU_CALLBACK_URL=http://121.196.161.249:8888/qianfu-api/notify
QIANYU_SIGN_ALGORITHM=HmacSHA256
QIANYU_TIMEOUT=30000
QIANYU_RETRY_COUNT=3

# ========== 服务器配置 ==========
SERVER_PORT=8888
SERVER_CONTEXT_PATH=/

# ========== 数据库配置 (自动检测) ==========
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xpay
DB_USERNAME=root
DB_PASSWORD=123456
DB_POOL_SIZE=20

# ========== Redis配置 (自动检测) ==========
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1
REDIS_TIMEOUT=10000

# ========== 邮件配置 (可选) ==========
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=

# ========== 支付配置 ==========
PAYMENT_DEFAULT_AMOUNT=100
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=100000
PAYMENT_EXPIRE_MINUTES=120

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_PATH=./logs
LOG_MAX_SIZE=100MB
LOG_MAX_DAYS=30

# ========== 环境标识 ==========
ENVIRONMENT=production
APP_NAME=StarMC-Payment
APP_VERSION=3.1.0
