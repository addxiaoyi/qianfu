# Elasticsearch 配置 (复制此文件为 .env.local 并填写真实密码)
# ============================================

# ES 节点地址
ELASTICSEARCH_NODE=http://localhost:9200

# ES 认证凭据
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=qianfu_elasticsearch_pass

# Kibana 配置 (可选)
KIBANA_URL=http://localhost:5601
KIBANA_USERNAME=kibana_system
KIBANA_PASSWORD=qianfu_kibana_system_pass

# 索引配置
ES_INDEX_PREFIX=qianfu-servers
ES_INDEX_NAME=qianfu-servers-v1

# 功能开关
FEATURE_FLAG_ES_SEARCH=false
ES_SEARCH_WEIGHT_NAME=10
ES_SEARCH_WEIGHT_NAME_EN=8
ES_SEARCH_WEIGHT_TAGS=5
ES_SEARCH_WEIGHT_SUMMARY=3
ES_SEARCH_WEIGHT_SUMMARY_EN=2.5
ES_SEARCH_WEIGHT_IP=1

# 性能配置
ES_REQUEST_TIMEOUT=30000
ES_MAX_RETRIES=3
ES_RETRY_DELAY=1000

# 缓存配置
ES_CACHE_TTL=60
